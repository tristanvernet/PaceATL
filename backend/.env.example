PORT=3001
# LAN access for a phone on the same Wi-Fi. Use 127.0.0.1 for local-only testing.
HOST=0.0.0.0
# Browser preview origins; native apps do not use browser CORS.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Server-side MySQL settings only. Get the port, username and password from Jacob.
DB_HOST=mysql-48e104f-swe-project-fall26.c.aivencloud.com
DB_PORT=PASTE_JACOBS_PORT
DB_NAME=defaultdb
DB_USER=PASTE_JACOBS_USERNAME
DB_PASSWORD="PASTE_JACOBS_PASSWORD"
# Relative to backend/, regardless of the shell's working directory.
DB_CA_PATH=../database/ca.pem
