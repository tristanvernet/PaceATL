{
  "name": "@paceatl/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "db:check": "node --env-file-if-exists=.env scripts/database-check.js",
    "db:setup": "node --env-file-if-exists=.env scripts/database-setup.js",
    "db:seed": "node --env-file-if-exists=.env scripts/tutorial-seed.js",
    "test:integration": "node --env-file-if-exists=.env scripts/integration-check.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mysql2": "^3.24.5"
  }
}
